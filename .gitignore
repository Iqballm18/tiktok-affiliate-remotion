# ==========================================
# Dependencies
# ==========================================
node_modules/
package-lock.json.backup

# ==========================================
# Remotion & Webpack Build Outputs (~35MB+)
# ==========================================
build/
dist/
.remotion/

# ==========================================
# Video Render Outputs (MP4, PNG Frames, etc.)
# ==========================================
out/*
!out/.gitkeep

# ==========================================
# Large AI Models & Whisper Binaries (~600MB+)
# ==========================================
whisper.cpp/
models/
*.bin

# ==========================================
# Large Raw Video Footages & Test Media
# (GitHub rejects files > 100MB like video_1.MOV)
# ==========================================
*.mov
*.MOV
*.mp4
*.MP4
*.mkv
*.avi
*.webm

# ==========================================
# User Product Configurations (products/*.json)
# Simpan template sample saja di git jika perlu
# ==========================================
products/*
!products/.gitkeep
!products/bagus-serap-air.json

# ==========================================
# Raw Media, Footages & Subtitles inside public/
# (Hanya simpan audio SFX bawaan & gitkeep di git)
# ==========================================
public/*
!public/sfx/
!public/sfx/**
!public/bgm/
!public/bgm/**
!public/.gitkeep
public/products/
public/products/**

# ==========================================
# Sensitive Local Config & API Credentials
# ==========================================
config.json
.env
.env.*
.env.local
!config.example.json

# ==========================================
# Local AI Assistant Workspace & Tool Caches
# ==========================================
.agents/
.claude/
.taste-skill/
.gemini/

# ==========================================
# Editor & IDE Directories
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# Logs & Temporary Files
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
